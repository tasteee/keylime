# ---------------------------------------------------------------------------
# Convex + Better Auth (new backend — see CONVEX_MIGRATION.md)
# ---------------------------------------------------------------------------
# Filled in automatically by `npx convex dev` (CONVEX_DEPLOYMENT + PUBLIC_CONVEX_URL).
CONVEX_DEPLOYMENT=
PUBLIC_CONVEX_URL=
# The .convex.site URL for your deployment (same name as PUBLIC_CONVEX_URL, .site TLD).
PUBLIC_CONVEX_SITE_URL=
# Public origin of this SvelteKit app.
PUBLIC_SITE_URL=http://localhost:3124

# Set on the Convex deployment itself (not read by the app), via:
#   npx convex env set BETTER_AUTH_SECRET=$(openssl rand -base64 32)
#   npx convex env set SITE_URL http://localhost:3124

# ---------------------------------------------------------------------------
# Supabase (legacy — still in use until the Stage 2 cutover)
# ---------------------------------------------------------------------------
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
