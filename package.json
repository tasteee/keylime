{
	"name": "keylime",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 3124",
		"build": "vite build",
		"preview": "vite preview --port 3125",
		"api:dev": "npx wrangler dev --config worker/wrangler.toml --port 8787",
		"api:deploy": "npx wrangler deploy --config worker/wrangler.toml",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"db:migrate:local": "npx wrangler d1 migrations apply keylime-db --local --config worker/wrangler.toml",
		"db:migrate:remote": "npx wrangler d1 migrations apply keylime-db --remote --config worker/wrangler.toml"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260702.1",
		"@internationalized/date": "^3.10.0",
		"@playwright/test": "^1.55.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^2.43.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.0",
		"@types/node": "^22",
		"@vitest/browser": "^3.2.4",
		"playwright": "^1.55.1",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"svelte": "^5.39.5",
		"svelte-check": "^4.3.2",
		"typescript": "^5.9.2",
		"vite": "^7.1.7",
		"vite-plugin-devtools-json": "^1.0.0",
		"vitest": "^3.2.4",
		"vitest-browser-svelte": "^1.1.0",
		"wrangler": "^4.156.0"
	},
	"dependencies": {
		"@fontsource-variable/saira": "^5.2.11",
		"@tasteee/zest": "github:tasteee/zest#build",
		"@tonaljs/voicing": "^5.1.2",
		"@tonaljs/voicing-dictionary": "^5.1.2",
		"@types/store": "^2.0.5",
		"array-range": "^1.0.1",
		"await-to-js": "^3.0.0",
		"await-to-ts": "^1.0.6",
		"dayjs": "^1.11.19",
		"fuzzy": "^0.1.3",
		"just-memoize": "^2.2.0",
		"midi-writer-js": "^3.1.1",
		"phosphor-svelte": "^3.0.1",
		"smplr": "^0.16.3",
		"store": "^2.0.12",
		"tiny-invariant": "^1.3.3",
		"tiny-warning": "^1.0.3",
		"tonal": "^6.4.2",
		"webmidi": "^3.1.14"
	}
}
